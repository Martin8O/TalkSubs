{
 "title": "ApiContract",
 "description": "Every shape the server and the window exchange.",
 "type": "object",
 "additionalProperties": false,
 "$defs": {
  "AddJobRequest": {
   "additionalProperties": false,
   "properties": {
    "path": {
     "maxLength": 4096,
     "minLength": 1,
     "type": "string"
    }
   },
   "required": [
    "path"
   ],
   "title": "AddJobRequest",
   "type": "object"
  },
  "AddLinkRequest": {
   "additionalProperties": false,
   "properties": {
    "url": {
     "maxLength": 8192,
     "minLength": 1,
     "type": "string"
    }
   },
   "required": [
    "url"
   ],
   "title": "AddLinkRequest",
   "type": "object"
  },
  "CardPackEvent": {
   "additionalProperties": false,
   "properties": {
    "type": {
     "const": "card_pack",
     "default": "card_pack",
     "type": "string"
    },
    "seq": {
     "type": "integer"
    },
    "card_pack": {
     "$ref": "#/$defs/ModelsInfo"
    }
   },
   "required": [
    "type",
    "seq",
    "card_pack"
   ],
   "title": "CardPackEvent",
   "type": "object"
  },
  "CheckRequest": {
   "additionalProperties": false,
   "properties": {
    "cues": {
     "items": {
      "$ref": "#/$defs/Cue-Input"
     },
     "type": "array"
    }
   },
   "required": [
    "cues"
   ],
   "title": "CheckRequest",
   "type": "object"
  },
  "CheckResult": {
   "additionalProperties": false,
   "properties": {
    "violations": {
     "items": {
      "$ref": "#/$defs/Violation"
     },
     "type": "array"
    }
   },
   "required": [
    "violations"
   ],
   "title": "CheckResult",
   "type": "object"
  },
  "Cue-Input": {
   "additionalProperties": false,
   "description": "One subtitle: its own text (one string per line) and times on the track's frame grid.",
   "properties": {
    "id": {
     "description": "Stable within its track; new cues take the track's next_cue_id",
     "minimum": 1,
     "type": "integer"
    },
    "start_ms": {
     "minimum": 0,
     "type": "integer"
    },
    "end_ms": {
     "minimum": 0,
     "type": "integer"
    },
    "lines": {
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "translation": {
     "anyOf": [
      {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "The cue's translation, one string per line; None while not translated"
    }
   },
   "required": [
    "id",
    "start_ms",
    "end_ms",
    "lines"
   ],
   "title": "Cue",
   "type": "object"
  },
  "Cue-Output": {
   "additionalProperties": false,
   "description": "One subtitle: its own text (one string per line) and times on the track's frame grid.",
   "properties": {
    "id": {
     "description": "Stable within its track; new cues take the track's next_cue_id",
     "minimum": 1,
     "type": "integer"
    },
    "start_ms": {
     "minimum": 0,
     "type": "integer"
    },
    "end_ms": {
     "minimum": 0,
     "type": "integer"
    },
    "lines": {
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "translation": {
     "anyOf": [
      {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "The cue's translation, one string per line; None while not translated"
    }
   },
   "required": [
    "id",
    "start_ms",
    "end_ms",
    "lines",
    "translation"
   ],
   "title": "Cue",
   "type": "object"
  },
  "DialogRequest": {
   "additionalProperties": false,
   "properties": {
    "kind": {
     "enum": [
      "files",
      "folder"
     ],
     "type": "string"
    }
   },
   "required": [
    "kind"
   ],
   "title": "DialogRequest",
   "type": "object"
  },
  "DialogResult": {
   "additionalProperties": false,
   "properties": {
    "paths": {
     "items": {
      "type": "string"
     },
     "type": "array"
    }
   },
   "required": [
    "paths"
   ],
   "title": "DialogResult",
   "type": "object"
  },
  "Document": {
   "additionalProperties": false,
   "properties": {
    "schema_version": {
     "const": 3,
     "default": 3,
     "type": "integer"
    },
    "app_version": {
     "type": "string"
    },
    "media": {
     "$ref": "#/$defs/Media"
    },
    "run_config": {
     "$ref": "#/$defs/RunConfig"
    },
    "segments": {
     "items": {
      "$ref": "#/$defs/Segment"
     },
     "type": "array"
    },
    "subtitles": {
     "description": "At most one track per preset",
     "items": {
      "$ref": "#/$defs/SubtitleTrack"
     },
     "type": "array"
    }
   },
   "required": [
    "schema_version",
    "app_version",
    "media",
    "run_config",
    "segments",
    "subtitles"
   ],
   "title": "Document",
   "type": "object"
  },
  "ErrorResponse": {
   "additionalProperties": false,
   "properties": {
    "error": {
     "type": "string"
    }
   },
   "required": [
    "error"
   ],
   "title": "ErrorResponse",
   "type": "object"
  },
  "ExportConflict": {
   "additionalProperties": false,
   "description": "409 from export: these files exist; ask the user, then send the request again with replace = true.",
   "properties": {
    "error": {
     "type": "string"
    },
    "existing": {
     "items": {
      "type": "string"
     },
     "type": "array"
    }
   },
   "required": [
    "error",
    "existing"
   ],
   "title": "ExportConflict",
   "type": "object"
  },
  "ExportRequest": {
   "additionalProperties": false,
   "properties": {
    "presets": {
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "formats": {
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "replace": {
     "default": false,
     "type": "boolean"
    },
    "texts": {
     "items": {
      "enum": [
       "original",
       "translation"
      ],
      "type": "string"
     },
     "minItems": 1,
     "type": "array"
    }
   },
   "required": [
    "presets",
    "formats"
   ],
   "title": "ExportRequest",
   "type": "object"
  },
  "ExportResult": {
   "additionalProperties": false,
   "properties": {
    "folder": {
     "type": "string"
    },
    "files": {
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "skipped": {
     "items": {
      "type": "string"
     },
     "type": "array"
    }
   },
   "required": [
    "folder",
    "files",
    "skipped"
   ],
   "title": "ExportResult",
   "type": "object"
  },
  "FileSource": {
   "additionalProperties": false,
   "description": "A media file on this machine, used where it is.",
   "properties": {
    "kind": {
     "const": "file",
     "default": "file",
     "type": "string"
    },
    "path": {
     "type": "string"
    }
   },
   "required": [
    "kind",
    "path"
   ],
   "title": "FileSource",
   "type": "object"
  },
  "FrameRate": {
   "additionalProperties": false,
   "description": "Exact video frame rate as a fraction, e.g. 30000/1001.",
   "properties": {
    "num": {
     "exclusiveMinimum": 0,
     "type": "integer"
    },
    "den": {
     "exclusiveMinimum": 0,
     "type": "integer"
    }
   },
   "required": [
    "num",
    "den"
   ],
   "title": "FrameRate",
   "type": "object"
  },
  "Job": {
   "additionalProperties": false,
   "properties": {
    "id": {
     "pattern": "^[0-9a-f]{12}$",
     "type": "string"
    },
    "name": {
     "type": "string"
    },
    "source": {
     "discriminator": {
      "mapping": {
       "file": "#/$defs/FileSource",
       "link": "#/$defs/LinkSource",
       "upload": "#/$defs/UploadSource"
      },
      "propertyName": "kind"
     },
     "oneOf": [
      {
       "$ref": "#/$defs/FileSource"
      },
      {
       "$ref": "#/$defs/UploadSource"
      },
      {
       "$ref": "#/$defs/LinkSource"
      }
     ]
    },
    "state": {
     "default": "queued",
     "enum": [
      "fetching",
      "queued",
      "running",
      "done",
      "failed",
      "cancelled"
     ],
     "type": "string"
    },
    "created_at": {
     "type": "number"
    },
    "started_at": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "finished_at": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "attempts": {
     "default": 0,
     "type": "integer"
    },
    "error": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "note": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "project_file": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "progress": {
     "anyOf": [
      {
       "$ref": "#/$defs/JobProgress"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "engine": {
     "default": "parakeet",
     "type": "string"
    },
    "exported": {
     "default": [],
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "preview": {
     "anyOf": [
      {
       "$ref": "#/$defs/JobPreview"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "media_s": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    }
   },
   "required": [
    "id",
    "name",
    "source",
    "state",
    "created_at",
    "started_at",
    "finished_at",
    "attempts",
    "error",
    "note",
    "project_file",
    "progress",
    "engine",
    "exported",
    "preview",
    "media_s"
   ],
   "title": "Job",
   "type": "object"
  },
  "JobEvent": {
   "additionalProperties": false,
   "properties": {
    "type": {
     "const": "job",
     "default": "job",
     "type": "string"
    },
    "seq": {
     "type": "integer"
    },
    "job": {
     "$ref": "#/$defs/Job"
    }
   },
   "required": [
    "type",
    "seq",
    "job"
   ],
   "title": "JobEvent",
   "type": "object"
  },
  "JobPreview": {
   "additionalProperties": false,
   "description": "The small copy of the media the window plays, and its waveform. Live only: rebuilt from disk on every start.",
   "properties": {
    "state": {
     "enum": [
      "waiting",
      "making",
      "ready",
      "failed"
     ],
     "type": "string"
    },
    "kind": {
     "anyOf": [
      {
       "enum": [
        "video",
        "audio"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "fraction": {
     "default": 0.0,
     "maximum": 1.0,
     "minimum": 0.0,
     "type": "number"
    },
    "media_done_s": {
     "default": 0.0,
     "type": "number"
    },
    "media_total_s": {
     "default": 0.0,
     "type": "number"
    },
    "error": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "peaks_per_s": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    }
   },
   "required": [
    "state",
    "kind",
    "fraction",
    "media_done_s",
    "media_total_s",
    "error",
    "peaks_per_s"
   ],
   "title": "JobPreview",
   "type": "object"
  },
  "JobProgress": {
   "additionalProperties": false,
   "properties": {
    "phase": {
     "anyOf": [
      {
       "const": "fetch",
       "type": "string"
      },
      {
       "enum": [
        "load",
        "decode",
        "speech",
        "recognise",
        "done"
       ],
       "type": "string"
      }
     ]
    },
    "fraction": {
     "maximum": 1.0,
     "minimum": 0.0,
     "type": "number"
    },
    "media_done_s": {
     "type": "number"
    },
    "media_total_s": {
     "type": "number"
    },
    "eta_s": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    }
   },
   "required": [
    "phase",
    "fraction",
    "media_done_s",
    "media_total_s",
    "eta_s"
   ],
   "title": "JobProgress",
   "type": "object"
  },
  "Limits": {
   "additionalProperties": false,
   "properties": {
    "max_chars_per_line": {
     "maximum": 100,
     "minimum": 10,
     "type": "integer"
    },
    "max_lines": {
     "maximum": 2,
     "minimum": 1,
     "type": "integer"
    },
    "max_cps": {
     "maximum": 40,
     "minimum": 5,
     "type": "number"
    },
    "cps_counts_spaces": {
     "type": "boolean"
    },
    "min_duration_ms": {
     "maximum": 10000,
     "minimum": 0,
     "type": "integer"
    },
    "max_duration_ms": {
     "maximum": 20000,
     "minimum": 1000,
     "type": "integer"
    },
    "min_gap_frames": {
     "maximum": 25,
     "minimum": 0,
     "type": "integer"
    },
    "close_gaps_up_to_frames": {
     "maximum": 50,
     "minimum": 0,
     "type": "integer"
    },
    "default_fps": {
     "description": "Frame grid for audio-only media, e.g. 25/1",
     "pattern": "^\\d+(/\\d+)?$",
     "type": "string"
    }
   },
   "required": [
    "max_chars_per_line",
    "max_lines",
    "max_cps",
    "cps_counts_spaces",
    "min_duration_ms",
    "max_duration_ms",
    "min_gap_frames",
    "close_gaps_up_to_frames",
    "default_fps"
   ],
   "title": "Limits",
   "type": "object"
  },
  "LinkSource": {
   "additionalProperties": false,
   "description": "A recording behind a download link. Only its sound is fetched and kept (sealed, in the upload folder); the\nlink itself lives sealed beside it and never appears in a message - a presigned link's signature is a secret.",
   "properties": {
    "kind": {
     "const": "link",
     "default": "link",
     "type": "string"
    },
    "upload_id": {
     "pattern": "^[0-9a-f]{12}$",
     "type": "string"
    },
    "path": {
     "type": "string"
    },
    "shown": {
     "type": "string"
    },
    "had_video": {
     "default": false,
     "type": "boolean"
    },
    "frame_rate": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    }
   },
   "required": [
    "kind",
    "upload_id",
    "path",
    "shown",
    "had_video",
    "frame_rate"
   ],
   "title": "LinkSource",
   "type": "object"
  },
  "MachineEvent": {
   "additionalProperties": false,
   "properties": {
    "type": {
     "const": "machine",
     "default": "machine",
     "type": "string"
    },
    "seq": {
     "type": "integer"
    },
    "machine": {
     "$ref": "#/$defs/MachineInfo"
    }
   },
   "required": [
    "type",
    "seq",
    "machine"
   ],
   "title": "MachineEvent",
   "type": "object"
  },
  "MachineInfo": {
   "additionalProperties": false,
   "description": "What this PC runs the model on, and how fast: a job takes about fixed_s + media_s * per_s seconds.",
   "properties": {
    "device": {
     "enum": [
      "cuda",
      "cpu"
     ],
     "type": "string"
    },
    "reason": {
     "enum": [
      "card",
      "no_driver",
      "no_card",
      "card_too_old",
      "card_too_small",
      "no_card_support",
      "card_pack_missing",
      "driver_too_old"
     ],
     "type": "string"
    },
    "card": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "cpu_threads": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "fixed_s": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "per_s": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "measured_by": {
     "anyOf": [
      {
       "enum": [
        "test",
        "jobs"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "measuring": {
     "default": false,
     "type": "boolean"
    },
    "measure_waiting": {
     "default": false,
     "type": "boolean"
    }
   },
   "required": [
    "device",
    "reason",
    "card",
    "cpu_threads",
    "fixed_s",
    "per_s",
    "measured_by",
    "measuring",
    "measure_waiting"
   ],
   "title": "MachineInfo",
   "type": "object"
  },
  "Media": {
   "additionalProperties": false,
   "properties": {
    "source": {
     "description": "Absolute path of the media file when it was transcribed",
     "type": "string"
    },
    "name": {
     "type": "string"
    },
    "size_bytes": {
     "minimum": 0,
     "type": "integer"
    },
    "duration_ms": {
     "description": "Container duration reported by ffprobe",
     "minimum": 0,
     "type": "integer"
    },
    "decoded_ms": {
     "description": "Length of the decoded audio actually recognised",
     "minimum": 0,
     "type": "integer"
    },
    "has_video": {
     "type": "boolean"
    },
    "frame_rate": {
     "anyOf": [
      {
       "$ref": "#/$defs/FrameRate"
      },
      {
       "type": "null"
      }
     ],
     "description": "None for audio-only files"
    },
    "audio_stream_index": {
     "description": "Which audio track was used (0 = first)",
     "minimum": 0,
     "type": "integer"
    },
    "audio_streams": {
     "minimum": 1,
     "type": "integer"
    },
    "sample_rate_hz": {
     "description": "Original sample rate of that track",
     "minimum": 0,
     "type": "integer"
    },
    "channels": {
     "description": "Original channel count of that track",
     "minimum": 0,
     "type": "integer"
    }
   },
   "required": [
    "source",
    "name",
    "size_bytes",
    "duration_ms",
    "decoded_ms",
    "has_video",
    "frame_rate",
    "audio_stream_index",
    "audio_streams",
    "sample_rate_hz",
    "channels"
   ],
   "title": "Media",
   "type": "object"
  },
  "ModelsEvent": {
   "additionalProperties": false,
   "properties": {
    "type": {
     "const": "models",
     "default": "models",
     "type": "string"
    },
    "seq": {
     "type": "integer"
    },
    "models": {
     "$ref": "#/$defs/ModelsInfo"
    }
   },
   "required": [
    "type",
    "seq",
    "models"
   ],
   "title": "ModelsEvent",
   "type": "object"
  },
  "ModelsInfo": {
   "additionalProperties": false,
   "description": "The speech model's files: downloaded once, on the first start; the queue waits until they are in.",
   "properties": {
    "state": {
     "enum": [
      "checking",
      "absent",
      "downloading",
      "ready",
      "failed"
     ],
     "type": "string"
    },
    "done_bytes": {
     "default": 0,
     "minimum": 0,
     "type": "integer"
    },
    "total_bytes": {
     "default": 0,
     "minimum": 0,
     "type": "integer"
    },
    "eta_s": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "error": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "error_kind": {
     "anyOf": [
      {
       "enum": [
        "no_connection",
        "dropped",
        "secure",
        "site",
        "disk_full",
        "no_space",
        "damaged",
        "other"
       ],
       "type": "string"
      },
      {
       "type": "null"
